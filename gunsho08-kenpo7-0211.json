  {
   "id": "gunsho08-kenpo7-0211-0003",
   "pid": "1879502",
   "pages": [
    255
   ],
   "text": "右康光春やときまた雪ふかき奥山の檜原にかすむ明かたの空三番",
   "poems": [
    "61"
   ],
   "lb": []
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "やたの野の雪まの草の朝みとりなひかぬ色に春風そ吹",
   "kana": "",
   "speaker": "",
   "page": 253,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "朝日さす山の白雪消そめて霞にゆるき春の風かな",
   "kana": "",
   "speaker": "",
   "page": 253,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "をしなへて四方の木のめも春雨にまづあらはるゝ靑柳の糸",
   "kana": "",
   "speaker": "",
   "page": 253,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "春雨にぬれてをおらん人しれす待し櫻の花の下陰",
   "kana": "",
   "speaker": "",
   "page": 253,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "山陰やつれなく殘るあは雪も跡たえはつる春雨そふる",
   "kana": "",
   "speaker": "",
   "page": 253,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "深山への木のめも今は春雨にぬれつゝもゆる野への若草",
   "kana": "",
   "speaker": "",
   "page": 253,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "春はなを霞にけりな久堅の月のかつらも色かはるまて",
   "kana": "",
   "speaker": "",
   "page": 253,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "尋きてみる人やなき花咲ぬ朽木の柚の春の夜の月",
   "kana": "",
   "speaker": "",
   "page": 253,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "花の香をおのか匂に先立ていく木の梅を風さそふらん",
   "kana": "",
   "speaker": "",
   "page": 253,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "大かたはしるへともなき谷風にさそはれ出る鶯のこゑ",
   "kana": "",
   "speaker": "",
   "page": 253,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "松風も霞にむせふ高根よりほのかに出る春の夜の月",
   "kana": "",
   "speaker": "",
   "page": 253,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "香をとめておらはやおらむふかき夜の霞る月に匂ふ梅か枝",
   "kana": "",
   "speaker": "",
   "page": 253,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "靑柳の糸もとをゝの春風にひとりみたれぬ朝霞哉",
   "kana": "",
   "speaker": "",
   "page": 253,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "霞つゝ吹としもなき春風におのれこほれて匂ふ梅かえ",
   "kana": "",
   "speaker": "",
   "page": 253,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "池水の汀の柳露ちりて浪にしくるゝ春のむら雨",
   "kana": "",
   "speaker": "",
   "page": 253,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "かきくらし木の目春雨ふる時はみとりにぬるゝ山の色かな",
   "kana": "",
   "speaker": "",
   "page": 253,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "志賀のあまの鹽やく煙消ぬれと春はおほろの浪の上の月",
   "kana": "",
   "speaker": "",
   "page": 253,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "武藏野やなかむる末の山のはに麓かすめる春の月影",
   "kana": "",
   "speaker": "",
   "page": 253,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "春日野の若菜もしろくふる雪に春の衣のぬれぬ日はなし",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "雪降はみ山や寒きしからきの外山にいつる鶯のこゑ",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "春日野やけふさへ雪もふりはへて袖白妙に若菜つむらし",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "咲そむる花かとそ見るかたをかの小松か原にふれるあは雪",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "百千鳥こゑは春めく空なからそれかと殘る谷のうす雪",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "若菜つむ我ころも手も白妙の雪をまかへて打はらひつゝ",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "たれしかも野へに心のあくかれてそこともいはぬ花を見る覽",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "あさな〓〓きゝす鳴なりむさし野の霞のうちに妻やこもれる",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "末とをき野たのすくろに立雁の行衞もかすむ春の空かな",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "草枕またやむすばん春の日のかすみてくらす武藏のゝ原",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "をく霜のいく重か下にかれはてし野へも綠に春はきにけり",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "いつしかともえ出ぬらし春日野の飛火のゝへの春の若草",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "白雲や花よりうへにかゝるらむ櫻そたかきかつらきの山",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "花なれや遠かた霞む山のはに月もへたてぬ春の白雲",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "時わかぬ雪間もかすむ富士の山煙や春の色にみゆちん",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "吉野山さのみは花もなかりけり人たのめなる峯の白雲",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "三よし野の山の白雲ふみ分て花になれぬる春そへにける",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "櫻さく春の山人やまにても花に心やあくかれぬらむ",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "春の田の苗代水にせきかけて谷の小河は雪なかるなり",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "谷川の岩間の氷かつとけて下行水のかけそうつろふ",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "さま〓〓に小田の苗代いそくらし行方しけき山河の水",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "住吉のあさゝはをのゝ忘水たえ〓〓ならぬ春雨のころ",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "春風に芦間の氷とけはてゝ野澤の水にかはつ鳴なり",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "やちとせをすむへき御代の始とていはひそそむる春の若水",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "山ふきの花のしからみかひもなしとまらぬ春のゐての里人",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "いたつらに雪とそ花はふる里の吉野の山の春の梅かえ",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "春きても雪けの雲のさむけれは煙たゆまぬ大原のさと",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "もしほ燒けふりと人やなかむらん霞棚ひくあしのやの里",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "此ころはしほ燒あまもいとまあれや芦屋の里の春の日くらし",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "見わたせはあさけの煙打なひき霞めるかたや深草の里",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "いふき山もゆる思のけふりをも霞めるころはしる人もなし",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "夕されは軒端の梅の移香にぬしさたまらす打なかめつゝ",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "はかなしや春のいく夜をまとろまて夢より外に猶たのみつゝ",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "春の日のなかき契りやすかのねの枯にし色に消るあは雪",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "きえぬともしらしな人は谷ふかみ下行水の春のあは雪",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "をしなへてかすめる比のしほかまはいつれ思の煙なるらん",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "神風やあまてるかけの春の日になかき契を猶むすふらし",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "なかき日の千とせのかすと今年より春くはゝれる君か御代哉",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "雲そなき春の朝日もさしはへて三笠の山のかけそのとけき",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "君そ見む常磐堅磐の色なから松と竹との萬代の春",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "色かへぬときはの松の陰よりも君か千とせの春にあふころ",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "幾度か折てかさゝむかきりなき雲井の松の春の初花",
   "kana": "",
   "speaker": "",
   "page": 254,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "春やときまた雪ふかき奥山の檜原にかすむ明かたの空",
   "kana": "",
   "speaker": "",
   "page": 255,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
